  }
}

function detectBaseUrl() {
  const href = location.href.split('#')[0];
  if (!href || href === 'about:srcdoc' || href === 'about:blank') return '';
  if (href.startsWith('about:') || href.startsWith('blob:') || href.startsWith('data:') || href.startsWith('file:') || href.startsWith('content:')) return '';
  if (!/^https?:\/\//.test(href)) return '';
  return href.replace(/#.*$/, '');
}
function updateBaseUrlStatus() {
  const status = document.getElementById('baseUrlStatus');
  const base = document.getElementById('baseUrlInput').value.trim();
  if (!base) {
    status.innerHTML = '<div class="warn-box"><b>⚠️ Base URL gerekli.</b> Link oluşturmak için hosting adresini gir.</div>';
  } else if (/^https?:\/\//.test(base) && !base.includes('#')) {
    status.innerHTML = '<div class="ok-box"><b>✅ URL geçerli.</b> Link Google\'da açılabilir.</div>';
  } else if (base.includes('#')) {
    status.innerHTML = '<div class="warn-box">⚠️ URL <b>#</b> içeriyor. Sadece ana adresi gir (örn: <code>https://xyz.netlify.app/kart.html</code>).</div>';
  } else {
    status.innerHTML = '<div class="warn-box">⚠️ URL <b>http://</b> veya <b>https://</b> ile başlamalı.</div>';
  }
}

