function drawBalloon(ctx, s, color) { ctx.beginPath(); ctx.ellipse(0, 0, s*0.42, s*0.55, 0, 0, Math.PI * 2); ctx.fill(); ctx.strokeStyle = color; ctx.lineWidth = 1.2; ctx.beginPath(); ctx.moveTo(0, s*0.55); ctx.bezierCurveTo(s*0.25, s*0.8, -s*0.25, s*1.0, 0, s*1.4); ctx.stroke(); }
function drawPetal(ctx, s) { ctx.beginPath(); ctx.ellipse(0, 0, s*0.5, s*0.85, 0, 0, Math.PI * 2); ctx.fill(); }

function launchConfetti(colors, type) {
  const canvas = document.getElementById('confetti');
  const ctx = canvas.getContext('2d');
  const resize = () => { canvas.width = innerWidth; canvas.height = innerHeight; };
  resize();
  window.addEventListener('resize', resize);
  if (confettiRAF) cancelAnimationFrame(confettiRAF);
  const particles = [];
  const count = type === 'emojis' ? 90 : 170;
  for (let i = 0; i < count; i++) {
    const p = {
      x: Math.random() * canvas.width, y: Math.random() * -canvas.height,
      vy: 2 + Math.random() * 3.5, vx: -1.2 + Math.random() * 2.4,
      rot: Math.random() * Math.PI * 2, vr: -0.15 + Math.random() * 0.3,
      color: colors[Math.floor(Math.random() * colors.length)],
      w: 6 + Math.random() * 8, h: 8 + Math.random() * 10
    };
    if (type === 'emojis') { p.emoji = CONFETTI_EMOJIS[Math.floor(Math.random() * CONFETTI_EMOJIS.length)]; p.w = p.h = 20 + Math.random() * 14; }
    else if (type === 'mixed') p.shape = Math.random() > 0.5 ? 'rect' : 'circle';
    else p.shape = type;
    particles.push(p);
  }
  const start = performance.now();
  function animate(now) {
    const elapsed = now - start;
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    for (const p of particles) {
      p.x += p.vx; p.y += p.vy; p.vy += 0.02; p.rot += p.vr;
      if (p.y > canvas.height + 50) { p.y = -30; p.x = Math.random() * canvas.width; p.vy = 2 + Math.random() * 3; }
      ctx.save(); ctx.translate(p.x, p.y); ctx.rotate(p.rot); ctx.fillStyle = p.color;
      if (p.shape === 'rect') ctx.fillRect(-p.w/2, -p.h/2, p.w, p.h);
      else if (p.shape === 'circle') { ctx.beginPath(); ctx.arc(0, 0, p.w/2, 0, Math.PI*2); ctx.fill(); }
      else if (p.shape === 'hearts') drawHeart(ctx, p.w * 0.7);
      else if (p.shape === 'stars') drawStar(ctx, p.w * 0.7);
      else if (p.shape === 'sparkles') drawSparkle(ctx, p.w * 0.7);
      else if (p.shape === 'balloons') drawBalloon(ctx, p.w * 0.7, p.color);
      else if (p.shape === 'petals') drawPetal(ctx, p.w * 0.6);
      else if (p.shape === 'emojis') { ctx.font = p.w + 'px serif'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle'; ctx.fillText(p.emoji, 0, 0); }
      ctx.restore();
    }
    if (elapsed < 10000) confettiRAF = requestAnimationFrame(animate);
    else ctx.clearRect(0, 0, canvas.width, canvas.height);
  }
  confettiRAF = requestAnimationFrame(animate);
}

let currentAudioCtx = null, musicPlaying = false;
function stopMusic() { if (currentAudioCtx) { try { currentAudioCtx.close(); } catch {} currentAudioCtx = null; } musicPlaying = false; }
function playHappyBirthday() {
  stopMusic();
  try { currentAudioCtx = new (window.AudioContext || window.webkitAudioContext)(); } catch { return; }
  const ctx = currentAudioCtx;
  const notes = { 'G4':392,'A4':440,'B4':493.88,'C5':523.25,'D5':587.33,'E5':659.25,'F5':698.46,'G5':783.99 };
  const melody = [['G4',1],['G4',1],['A4',2],['G4',2],['C5',2],['B4',4],['G4',1],['G4',1],['A4',2],['G4',2],['D5',2],['C5',4],['G4',1],['G4',1],['G5',2],['E5',2],['C5',2],['B4',2],['A4',4],['F5',1],['F5',1],['E5',2],['C5',2],['D5',2],['C5',4]];
  const tempo = 0.32;
  let time = ctx.currentTime + 0.1;
  melody.forEach(([note, beats]) => {
    const dur = beats * tempo;
    const osc = ctx.createOscillator(); const gain = ctx.createGain();
    osc.type = 'triangle'; osc.frequency.value = notes[note];
    gain.gain.setValueAtTime(0, time);
    gain.gain.linearRampToValueAtTime(0.13, time + 0.04);
    gain.gain.exponentialRampToValueAtTime(0.001, time + dur * 0.95);
    osc.connect(gain); gain.connect(ctx.destination);
    osc.start(time); osc.stop(time + dur);
    time += dur * 0.98;
  });
  musicPlaying = true;
}
function playPop() {
  if (!currentSoundEffects) return;
  try {
    const c = new (window.AudioContext || window.webkitAudioContext)();
    const o = c.createOscillator(); const g = c.createGain();
    o.type = 'sine';
    o.frequency.setValueAtTime(400, c.currentTime);
    o.frequency.exponentialRampToValueAtTime(1200, c.currentTime + 0.1);
    g.gain.setValueAtTime(0.15, c.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001, c.currentTime + 0.15);
    o.connect(g); g.connect(c.destination);
    o.start(); o.stop(c.currentTime + 0.2);
    setTimeout(() => c.close(), 400);
  } catch {}
}
function playBlow() {
  if (!currentSoundEffects) return;
  try {
    const c = new (window.AudioContext || window.webkitAudioContext)();
    const bufSize = c.sampleRate * 0.3;
    const buf = c.createBuffer(1, bufSize, c.sampleRate);
    const data = buf.getChannelData(0);
    for (let i = 0; i < bufSize; i++) data[i] = (Math.random() * 2 - 1) * (1 - i/bufSize) * 0.3;
    const src = c.createBufferSource(); src.buffer = buf;
    const g = c.createGain(); g.gain.value = 0.4;
    const filt = c.createBiquadFilter(); filt.type = 'lowpass'; filt.frequency.value = 800;
    src.connect(filt); filt.connect(g); g.connect(c.destination);
    src.start();
    setTimeout(() => c.close(), 500);
  } catch {}
}

/* MİKROFON */
let micStream = null, micAnalyser = null, micRAF = null, blowActive = false;
async function startBlowDetection() {
  if (blowActive) return;
  const blowBtn = document.getElementById('blowBtn');
  const hintEl = document.getElementById('cakeHint');
  if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
    showToast('Mikrofon desteklenmiyor', '#f59e0b');
    return;
  }
  try {
    micStream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
    const ctx = new (window.AudioContext || window.webkitAudioContext)();
    const src = ctx.createMediaStreamSource(micStream);
    micAnalyser = ctx.createAnalyser();
    micAnalyser.fftSize = 512;
    micAnalyser.smoothingTimeConstant = 0.6;
    src.connect(micAnalyser);
    const data = new Uint8Array(micAnalyser.frequencyBinCount);
    blowActive = true;
    blowBtn.classList.add('listening');
    blowBtn.textContent = '🎤 Üflüyorum...';
    hintEl.textContent = 'Mikrofona üfle! 🎤';
    hintEl.classList.remove('hidden');
    const startTime = Date.now();
    function check() {
      if (!blowActive) return;
      if (Date.now() - startTime > 15000) {
        stopBlowDetection();
        showToast('Süre doldu, tekrar dene', '#f59e0b');
        return;
      }
      micAnalyser.getByteFrequencyData(data);
      let sum = 0;
      for (let i = 0; i < data.length; i++) sum += data[i];
      const avg = sum / data.length;
      if (avg > 45) {
        blowAllCandles();
        return;
      }
      micRAF = requestAnimationFrame(check);
    }
    check();
  } catch (err) {
    console.error(err);
    showToast('Mikrofon izni gerekli', '#ef4444');
    blowActive = false;
  }
}
function stopBlowDetection() {
  blowActive = false;
  if (micRAF) cancelAnimationFrame(micRAF);
  if (micStream) { micStream.getTracks().forEach(t => t.stop()); micStream = null; }
  micAnalyser = null;
  const blowBtn = document.getElementById('blowBtn');
  if (blowBtn) { blowBtn.classList.remove('listening'); blowBtn.textContent = '🎤 Üfle'; }
}
function blowAllCandles() {
  stopBlowDetection();
  const cakeEl = document.getElementById('bcCake');
  const hintEl = document.getElementById('cakeHint');
  const candles = cakeEl.querySelectorAll('.candle:not(.blown)');
  candles.forEach((c, i) => {
    setTimeout(() => { c.classList.add('blown'); playBlow(); }, i * 200);
  });
  setTimeout(() => {
    if (currentCard) launchConfetti(currentCard.theme.confetti, currentCard.data.ct || 'mixed');
    hintEl.textContent = '🎉 Dileğin gerçek olsun!';
    playPop();
    if (navigator.vibrate) navigator.vibrate([100, 50, 100]);
  }, candles.length * 200 + 400);
}

let currentCard = null;
let currentSoundEffects = true;

function buildFloatingStickers(stickers) {
  const wrap = document.getElementById('floatingStickers');
  wrap.innerHTML = '';
  if (!stickers || !stickers.length) return;
  const positions = [{ top: '8%', left: '6%' },{ top: '16%', right: '8%' },{ bottom: '20%', left: '10%' },{ bottom: '10%', right: '6%' },{ top: '50%', left: '3%' }];
  const anims = ['floatA','floatB','floatC','floatA','floatB'];
  const durs = ['3.6s','4.1s','3.9s','4.4s','4s'];
  const delays = ['0s','0.4s','0.8s','1.2s','0.2s'];
  stickers.slice(0, 5).forEach((emoji, i) => {
    const el = document.createElement('span');
    el.className = 'floating-sticker';
    el.textContent = emoji;
    const pos = positions[i];
    Object.assign(el.style, { top: pos.top || '', left: pos.left || '', right: pos.right || '', bottom: pos.bottom || '', animation: `${anims[i]} ${durs[i]} ease-in-out ${delays[i]} infinite` });
    wrap.appendChild(el);
  });
}

function showCardView(data) {
  document.getElementById('editor').classList.add('hidden');
  const cv = document.getElementById('cardView');
  cv.classList.remove('hidden');
  window.scrollTo(0, 0);
  const t = THEMES[data.t] || THEMES.pembe;
  cv.style.background = t.bg;
  buildFloatingStickers(data.s);
  currentCard = { data, theme: t };
  currentSoundEffects = data.se !== 0;
  document.getElementById('giftBox').textContent = data.gb || '🎁';
  document.getElementById('giftStage').classList.remove('hidden');
  document.getElementById('cardStage').classList.add('hidden');
  if (data.mu) document.getElementById('musicBtn').classList.remove('hidden');
  if (data.ao) setTimeout(() => openCard(), 400);
}

function typeWriter(el, text, speed = 35) {
  return new Promise(resolve => {
    el.textContent = '';
    el.classList.add('typing');
    let i = 0;
    const timer = setInterval(() => {
      el.textContent = text.slice(0, ++i);
      if (i >= text.length) {
        clearInterval(timer);
        setTimeout(() => el.classList.remove('typing'), 600);
        resolve();
      }
    }, speed);
  });
}

function openCard() {
  if (!currentCard) return;
  const { data, theme } = currentCard;
  const card = document.getElementById('birthdayCard');

  applyCardDesign(card, {
    theme: data.t, layout: data.ly || 'classic', aspect: data.ar || 'portrait',
    accent: data.ac, cardBg: data.cb, textColor: data.tc,
    borderRadius: data.br, titleSize: data.ts, nameSize: data.ns, msgSize: data.ms,
    titleWeight: data.twt, nameWeight: data.nwt, msgWeight: data.mwt,
    letterSpacing: data.ls, lineHeight: data.lh, textEffect: data.te,
    cardTilt: data.tl, cardShadow: data.csh, photoSize: data.pz
  });
  applyPattern(document.getElementById('bcPattern'), data.pt || 'none');

  card.className = 'birthday-card layout-' + (data.ly || 'classic');
  if (data.ar === 'square') card.classList.add('ar-square');
  else if (data.ar === 'story') card.classList.add('ar-story');
  else if (data.ar === 'landscape') card.classList.add('ar-landscape');
  if (data.te && data.te !== 'none') card.classList.add('effect-' + data.te);
  card.classList.add('anim-' + (data.ca || 'pop'));
  void card.offsetWidth;

  const photoWrap = document.getElementById('bcPhotoWrap');
  const photo = document.getElementById('bcPhoto');
  if (data.ph) {
    photoWrap.classList.add('has-photo');
    photo.src = data.ph;
    applyPhoto(photo, { photoShape: data.psh, photoBorderWidth: data.pbw, photoBorderColor: data.pbc });
  } else photoWrap.classList.remove('has-photo');

  document.getElementById('bcEmoji').textContent = data.e || '🎂';
  if (data.ly === 'polaroid') document.getElementById('bcEmoji').style.display = 'none';

  const ageEl = document.getElementById('bcAge');
  if (data.a) { ageEl.textContent = `Nice ${data.a} yıllara! 🎉`; ageEl.classList.remove('hidden'); }
  else ageEl.classList.add('hidden');

  const dateEl = document.getElementById('bcDate');
  if (data.dt) { dateEl.textContent = data.dt; dateEl.classList.remove('hidden'); }
  else dateEl.classList.add('hidden');

  const titleEl = document.getElementById('bcTitle');
  titleEl.textContent = data.ti || 'İyi ki doğdun';
  titleEl.style.fontFamily = FONTS[data.tf] ? FONTS[data.tf].css : FONTS.pacifico.css;
  titleEl.style.textAlign = data.al || 'center';

  const nameEl = document.getElementById('bcName');
  nameEl.textContent = data.to || 'Sen';
  nameEl.style.fontFamily = FONTS[data.nf] ? FONTS[data.nf].css : FONTS.pacifico.css;
  nameEl.style.textAlign = data.al || 'center';

  const msgEl = document.getElementById('bcMsg');
  msgEl.style.fontFamily = FONTS[data.mf] ? FONTS[data.mf].css : FONTS.poppins.css;
  msgEl.style.textAlign = data.al || 'center';
  if (data.m) { msgEl.style.display = ''; msgEl.textContent = data.m; }
  else msgEl.style.display = 'none';

  document.getElementById('bcFromName').textContent = data.f || 'Bir arkadaşın';

  const cakeEl = document.getElementById('bcCake');
  const hintEl = document.getElementById('cakeHint');
  const blowBtn = document.getElementById('blowBtn');

  if (data.cd) {
    cakeEl.classList.remove('hidden');
    hintEl.classList.remove('hidden');
    hintEl.textContent = 'Mumlara dokun veya üfle 🕯️';
    if (data.mb) { blowBtn.classList.remove('hidden'); blowBtn.onclick = () => startBlowDetection(); }
    else blowBtn.classList.add('hidden');
    cakeEl.querySelectorAll('.candle').forEach(c => {
      c.classList.remove('blown');
      c.onclick = () => {
        if (c.classList.contains('blown')) return;
        c.classList.add('blown');
        playBlow();
        const remaining = cakeEl.querySelectorAll('.candle:not(.blown)').length;
        if (remaining === 0) {
          setTimeout(() => {
            launchConfetti(theme.confetti, data.ct || 'mixed');
            hintEl.textContent = '🎉 Dileğin gerçek olsun!';
            playPop();
            blowBtn.classList.add('hidden');
            if (navigator.vibrate) navigator.vibrate([100, 50, 100]);
          }, 300);
        }
      };
    });
  } else {
    cakeEl.classList.add('hidden');
    hintEl.classList.add('hidden');
    blowBtn.classList.add('hidden');
  }

  document.getElementById('giftStage').classList.add('hidden');
  document.getElementById('cardStage').classList.remove('hidden');
  launchConfetti(theme.confetti, data.ct || 'mixed');

  if (data.tw && data.m) setTimeout(() => typeWriter(msgEl, data.m, 30), 800);
  if (data.mu) { playHappyBirthday(); const mb = document.getElementById('musicBtn'); mb.textContent = '🔊'; mb.classList.add('playing'); }
}

document.getElementById('openCardBtn').addEventListener('click', () => { playPop(); openCard(); });
document.getElementById('giftBox').addEventListener('click', () => { playPop(); openCard(); });
document.getElementById('musicBtn').addEventListener('click', function() {
  if (musicPlaying) { stopMusic(); this.textContent = '🔇'; this.classList.remove('playing'); }
  else { playHappyBirthday(); this.textContent = '🔊'; this.classList.add('playing'); }
});
document.getElementById('createOwnBtn').addEventListener('click', (e) => {
  e.preventDefault();
  stopBlowDetection();
  stopMusic();
  document.getElementById('cardView').classList.add('hidden');
  document.getElementById('editor').classList.remove('hidden');
  window.scrollTo(0, 0);
});

function init() {
  if (window.__CARD_CONFIG__) { showCardView(window.__CARD_CONFIG__); return; }
  const hash = location.hash;
  if (hash.startsWith('#k=')) {
    try { const data = JSON.parse(fromB64Url(hash.slice(3))); showCardView(data); return; }
    catch (err) { console.warn('Kart okunamadı:', err); }
  }
  renderEnvInfo();
  buildPresets(); buildThemePicker(); buildPatternPicker(); buildEmojiPicker(); buildStickerPicker();
  buildFontPicker('titleFontPicker', 'titleFont');
  buildFontPicker('nameFontPicker', 'nameFont');
  buildFontPicker('msgFontPicker', 'msgFont');
  syncColorPickers(); updatePhotoUI();

  const savedBase = localStorage.getItem('cardBaseUrl') || '';
  const detectedBase = detectBaseUrl();
  document.getElementById('baseUrlInput').value = savedBase || detectedBase;
  updateBaseUrlStatus();
  document.getElementById('shareMsgInput').value = state.shareMsg;

  updatePreview();
}
init();
